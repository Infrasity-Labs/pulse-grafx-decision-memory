          "top_id": "decision_e998e9cb4cf8e6d54ea1470e",
          "top_title": "Sessions use one long-lived access token and the API has no refresh tokens.",
          "top_slug": "no-refresh-tokens",
          "top_similarity": 0.614688531029096,
          "results_returned": 4,
          "top_is_expected": true,
          "expected_in_results": true,
          "outcome": "success"
        }

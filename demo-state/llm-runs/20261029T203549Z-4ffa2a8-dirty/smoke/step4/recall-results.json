      "agent_choice": {
        "tool_used": [
          "okto_pulse_kg_find_similar_decisions",
          "okto_pulse_kg_get_decision_history"
        ],
        "decision_id": "decision_e998e9cb4cf8e6d54ea1470e",
        "decision_title": null,
        "slug": "no-refresh-tokens",
        "answer": "The API issues one access token valid for a week and has no refresh tokens, so a client logs in again to get a new one. Reason: security review SR-2025-14 found that a stored refresh token let a stolen browser profile keep access for months. Without one, a stolen token expires on its own.",
        "abstained": false,
        "correct": true
      }

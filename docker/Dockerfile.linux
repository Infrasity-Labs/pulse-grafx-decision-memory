# Linux image for the Linux crash run (scripts/run_linux.sh): the pinned Pulse and Grafx on python:3.12-slim.
# The base image is the same digest step 9 uses (see IMAGE in scripts/step09_backup_restore.py).
# Build context: a folder holding requirements.txt and constraints.txt only.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159
ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 PYTHONUNBUFFERED=1
COPY requirements.txt constraints.txt /pins/
# CPU build of torch: a "+cpu" build of the pinned number satisfies the pin in constraints.txt.
RUN pip install --extra-index-url https://download.pytorch.org/whl/cpu -r /pins/requirements.txt -c /pins/constraints.txt \
 && python -c "import importlib.metadata as m; [print(p, m.version(p)) for p in ('okto-pulse','okto-pulse-core','okto-grafx','sentence-transformers','torch','fastmcp')]"
WORKDIR /repo
